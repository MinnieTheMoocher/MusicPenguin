{
  "name": "musicpenguin",
  "version": "0.0.1",
  "homepage": "https://github.com/MinnieTheMoocher/MusicPenguin",
  "author": "MinnieTheMoocher@users.noreply.github.com",
  "description": "MusicPenguin - A fast Linux audio library and player",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinnieTheMoocher/MusicPenguin.git"
  },
  "main": "main.js",
  "scripts": {
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "build:renderer": "esbuild --bundle src/index.ts --outfile=dist/bundle.js --format=esm --sourcemap",
    "build:main": "esbuild --bundle src/main-process/index.ts --outfile=dist/main-bundle.js --platform=node --format=cjs --external:electron --external:music-metadata --external:sql.js --sourcemap",
    "watch": "npm run typecheck && esbuild --bundle src/index.ts --outfile=dist/bundle.js --format=esm --sourcemap --watch",
    "start": "npm run build && electron .",
    "electron": "electron ."
  },
  "keywords": ["linux", "music library", "music player", "music", "mp3", "audio"],
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron": "^42.3.2",
    "music-metadata": "^11.14.0",
    "sql.js": "^1.14.1"
  }
}
