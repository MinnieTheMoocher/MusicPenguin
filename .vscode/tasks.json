{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf ./dist/ ./node_modules/ ./*.deb"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "{ [ -d node_modules ] || npm i; } && npm run build"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "pack",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "./pack-deb.bash"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    }
  ]
}
