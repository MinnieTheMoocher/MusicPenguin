{
  "files.exclude": {
    "**/.git": true,
    // "node_modules/": true,
    // "dist/": true
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "editor.tabSize": 2,
  "editor.indentSize":"tabSize",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.formatOnType": false,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,

  "task.autoDetect": "off",

  "cSpell.enabled": true,
  "cSpell.enabledFileTypes": {
    "*": true,
  },
  "cSpell.words": [
    "allfiles",
    "APIC",
    "autoplay",
    "beautifications",
    "beforeunload",
    "browsable",
    "coverart",
    "Crashpad",
    "crossfade",
    "dbus",
    "Discogs",
    "DLNA",
    "dpkg",
    "esbuild",
    "EXTM3U",
    "ffprobe",
    "flac",
    "gedit",
    "kdedefaults",
    "kdeglobals",
    "libasound",
    "libnss",
    "libxss",
    "Matroska",
    "Mayall",
    "mousemove",
    "mouseup",
    "MPRIS",
    "MusicBrainz",
    "musicpenguin",
    "overscan",
    "playcount",
    "playmode",
    "recalc",
    "rescan",
    "setuid",
    "sqljs",
    "SSDP",
    "subdirs",
    "theatermode",
    "unscanned",
    "Vorbis"
  ]
}
