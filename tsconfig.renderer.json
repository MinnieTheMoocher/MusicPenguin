{
  // RENDERER CONFIG
  //
  // Type-checks the renderer (browser) process: everything in `src/` except
  // `src/main` — i.e. `src/renderer/` plus the shared `src/common/` folder
  // (`config.ts`, `i18n/`, `electron-types.d.ts`), which the renderer imports.
  //
  // This is one of two real process configs driven by `npm run typecheck`.
  // Give this and `tsconfig.main.json` different `target` values when you
  // want to downgrade the two processes independently (e.g. main -> ES2021 for
  // an older Node, renderer -> ES2023 for a newer Chromium).
  //
  // Note: tsc only type-checks here (`--noEmit` at the CLI). Actual JS emit is
  // done by esbuild via `build:renderer` in package.json, so the `target` below
  // is the feature floor that tsc validates against, not the emitted output.
  //
  // The root `tsconfig.json` is editor-only and NOT used by this build.
  "compilerOptions": {
    // Shared strictness / module settings (mirror of the root editor config).
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/main"]
}
